# Copia para ts-authkey e cola UMA auth key reutilizável do Tailscale (não efémera).
# Settings → Keys → Generate auth key → Reusable=yes, Ephemeral=no.
#
#   cp secrets/ts-authkey.example secrets/ts-authkey
#   chmod 600 secrets/ts-authkey
#   git add -f secrets/ts-authkey
#   git commit -m "auth key Tailscale para reset"
#   git push
#
# Repo é privado. Sem este ficheiro no clone, disco vazio não junta o nó.
